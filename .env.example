# Azure AD / Entra ID
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# NextAuth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Azure Subscription(s) - comma-separated for multi-sub
AZURE_SUBSCRIPTION_IDS=

# Database (SQLite for v1)
DATABASE_URL=file:./dev.db

# AI Agent (OpenAI or Azure OpenAI)
OPENAI_API_KEY=
# OR
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Mission:Control Partner API
MC_CLIENT_ID=
MC_CLIENT_SECRET=
MC_PARTNER_ID=
MC_TENANT_ID=
MC_ENVIRONMENT=sandbox

# Shopify App
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_inventory,write_inventory,write_fulfillments
SHOPIFY_APP_URL=http://localhost:3000

# Database (SQLite for v1)
DATABASE_URL=file:./dev.db

# AI Agent (OpenAI or Azure OpenAI)
OPENAI_API_KEY=
# OR
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
